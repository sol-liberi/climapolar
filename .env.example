# Copiá este archivo como .env y definí credenciales privadas antes de iniciar.
DB_PASSWORD=
ADMIN_USERNAME=climapolar
ADMIN_PASSWORD=
# Producción segura por defecto. Para usar http://localhost, cambiar temporalmente a false.
SESSION_COOKIE_SECURE=true
# Docker publica solamente en localhost para que un proxy HTTPS sea la entrada pública.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081
APP_MEMORY_LIMIT=768m
APP_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=512m
DB_CPU_LIMIT=1.0
CLIMAPOLAR_SECURITY_TRUSTED_PROXIES=127.0.0.1,::1
