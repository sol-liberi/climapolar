# Copiar a /etc/nginx/sites-available/climapolar.conf una vez emitido el certificado.
# El archivo cloudflare-real-ip.conf debe contener solo las redes oficiales actuales de Cloudflare.
server {
    listen 80;
    listen [::]:80;
    server_name climapolar.com.ar www.climapolar.com.ar;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://climapolar.com.ar$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.climapolar.com.ar;

    ssl_certificate /etc/letsencrypt/live/climapolar.com.ar/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/climapolar.com.ar/privkey.pem;

    return 301 https://climapolar.com.ar$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name climapolar.com.ar;

    ssl_certificate /etc/letsencrypt/live/climapolar.com.ar/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/climapolar.com.ar/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/snippets/cloudflare-real-ip.conf;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    client_max_body_size 180m;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;

        # Se sobrescriben; nunca se propagan valores X-Forwarded-* del visitante.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
